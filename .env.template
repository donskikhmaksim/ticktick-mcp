# === TickTick Open API (official, OAuth) ===
# Register an app at https://developer.ticktick.com to get these.
TICKTICK_CLIENT_ID=your_client_id_here
TICKTICK_CLIENT_SECRET=your_client_secret_here

# Populated automatically by 'uv run -m ticktick_mcp.cli auth' (local OAuth flow).
# On Railway, paste the access token here as an environment variable instead.
TICKTICK_ACCESS_TOKEN=
TICKTICK_REFRESH_TOKEN=

# === Unofficial v2 API (optional) ===
# Enables tags, completed-task history, Inbox reads, and moving tasks between
# lists. Auth = the `t` cookie from a logged-in ticktick.com browser session
# (DevTools → Application → Cookies → ticktick.com → copy value of `t`).
# Do NOT use username/password: TickTick gates signon behind a captcha.
# Leave blank to disable. The token is long-lived but expires — re-extract then.
TICKTICK_V2_TOKEN=

# === Transport / deployment ===
# Local: leave as stdio (default). Railway/remote: set to streamable-http.
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
# Railway injects PORT automatically; only set MCP_PORT for local HTTP testing.
MCP_PORT=8000
# Unguessable secret appended to the URL path (/mcp/<secret>) as lightweight
# auth for the public endpoint. Generate with: openssl rand -hex 24
# It is ALSO the root of the attachment-link signing key (a derived key, never
# the secret itself) — without MCP_SECRET the /dl and /ul links are disabled.
MCP_SECRET=

# Public base URL of this server, used to build temporary attachment links
# (/dl/<token>, /ul/<token>). On Railway you can leave this blank — the
# injected RAILWAY_PUBLIC_DOMAIN is used. Set it behind a custom domain/proxy.
# PUBLIC_BASE_URL=https://your-app.up.railway.app

# IANA timezone used when interpreting/formatting task due dates
# (e.g. Europe/Moscow, America/New_York). Defaults to UTC if unset.
USER_TIMEZONE=

# === Optional: LLM judge (declutter dedup/SMART-rewrite + destination suggestions) ===
# Deploy your own claude-p-shim (https://github.com/donskikhmaksim/claude-p-shim)
# and fill these in to enable it. Leave blank to skip — everything still works,
# just without the LLM-assisted parts.
# CLAUDE_CLI_URL=
# CLAUDE_CLI_TOKEN=
# CLAUDE_CLI_MODEL=sonnet

# === Optional: sheet-backed declutter manifest (plan_declutter(persist="sheet")) ===
# Durable Google Sheet manifest for the declutter tools — see
# docs/DESIGN_sheet_backed_declutter.md and the README section of the same name.
# Leave both blank to skip — plan_declutter's default persist="ram" is unaffected.
# DECLUTTER_SHEET_ID=
# Service-account key: either the raw JSON (single line) or a path to the key file.
# The service account's client_email must be shared on the sheet as Editor.
# GSHEETS_SA_JSON=

# === automation_key: отдельный ключ для headless-автоматики (2026-08-10) ===
# docs/TZ/TZ_temp_automation_key.md. Раньше automation_key сверялся с
# MCP_SECRET (у него уже есть свои две роли выше — путь /mcp/ и корень ключа
# подписи вложений); теперь у него СВОЙ отдельный секрет, генерируется один
# раз и меняется редко и осознанно. Generate with: openssl rand -hex 24
AUTOMATION_KEY=
# Срок жизни ОДНОГО временного окна, выдаваемого по команде /automation_key
# (или кнопке "Новый ключ") в Telegram (требует own_bot, см.
# TG_BOT_TOKEN_OVERRIDE ниже в докстринге tg_approval.py) — часы, дробные
# значения допустимы. Несколько окон могут быть активны одновременно (у
# каждого свой срок от МОМЕНТА ЕГО генерации) — повторное нажатие/вызов НЕ
# гасит уже выданные окна, см. docs/TZ/TZ_multi_automation_windows.md.
# AUTOMATION_WINDOW_HOURS=24
#
# ОБРАТНАЯ СОВМЕСТИМОСТЬ (временно): пока AUTOMATION_KEY не роздан внешним
# автоматизациям, старый MCP_SECRET ПРОДОЛЖАЕТ приниматься как automation_key
# — иначе существующие n8n-сценарии сломаются молча в момент выкладки. Канал
# уберётся отдельной правкой, когда все внешние клиенты переведены на
# AUTOMATION_KEY.

# === Долговечные планы подтверждения (задача #91) ===
# Планы, ушедшие в Telegram с кнопками, хранятся в таблице `mcp_manifests` в
# ТОЙ ЖЕ базе, что и `tg_approvals` (CONSENT_DATABASE_URL) — благодаря этому
# нажатие ✅ работает и после перезапуска сервиса. Отдельной настройки для
# включения нет: механизм поднимается вместе с TG_APPROVAL_ENABLED.
# Ручки ниже трогать обычно не нужно.
#
# Потолок на размер одного плана. План тяжелее просто не становится
# долговечным (живёт в памяти процесса, как раньше) — практически это
# attach_file_to_task с вложенным файлом.
# MANIFEST_PAYLOAD_MAX_BYTES=524288
# Пул соединений к Postgres для планов и сколько ждать свободного соединения.
# MANIFEST_PG_POOL_MAX=5
# MANIFEST_PG_POOL_WAIT_S=10

# === Сокрытие прямых путей изменения задач (заход 1, §1.3.4) ===
# Тринадцать инструментов, меняющих задачи напрямую (create_tasks,
# update_tasks, complete_tasks, delete_tasks, delete_task_with_subtasks,
# create_subtask, move_tasks, set_task_parent, unset_task_parent,
# set_task_tags, restore_tasks, abandon_task, duplicate_task) и старое имя
# агрегатора manual_triage НЕ показываются в ответе на tools/list: модель
# должна видеть один правильный путь — apply_task_changes. Из реестра они
# при этом НЕ удалены: вызвать их по имени с верным AUTOMATION_KEY (или,
# временно, старым MCP_SECRET — см. блок automation_key выше) в
# automation_key можно как раньше (это и есть путь для n8n), а фоновое
# исполнение по кнопке Telegram работает без изменений.
#
# ЭТО ЕДИНСТВЕННАЯ ТОЧКА ОТКАТА. Пустое значение (именно заданное пустым, а
# не отсутствующая переменная) возвращает модели прежний набор команд
# целиком. Отказ без ключа, псевдоним старого имени и отчёты продолжают
# работать в любом случае. После отката перезапустите MCP-КЛИЕНТА: список
# инструментов он кэширует на сессию.
# MCP_HIDDEN_TOOLS=
